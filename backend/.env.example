APP_NAME=omni-commerce-ai
APP_ENV=dev
APP_DEBUG=true

DATABASE_URL=postgresql+asyncpg://omni:omni_password@localhost:5432/omni_ai
REDIS_URL=redis://localhost:6379/0

# Auth / RBAC
AUTH_ENABLED=false
JWT_SECRET_KEY=change_me_in_local_env
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

LOG_LEVEL=INFO

# Model Gateway
DEFAULT_LLM_PROVIDER=mock
DEFAULT_EMBEDDING_PROVIDER=mock
DEFAULT_LLM_MODEL=mock-chat-model
DEFAULT_EMBEDDING_MODEL=mock-embedding-model

LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_API_KEY=

LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=2

# RAG / Knowledge Base
QDRANT_URL=http://localhost:6333
RAG_VECTOR_COLLECTION=omni_knowledge_chunks
RAG_VECTOR_SIZE=3
RAG_CHUNK_SIZE=500
RAG_CHUNK_OVERLAP=80
RAG_TOP_K=5
RAG_VECTOR_WEIGHT=0.65
RAG_KEYWORD_WEIGHT=0.35
RAG_RERANK_TOP_N=5

# OpenSearch
OPENSEARCH_URL=http://localhost:9200
OPENSEARCH_INDEX=omni_knowledge_chunks
OPENSEARCH_USERNAME=
OPENSEARCH_PASSWORD=

# MinIO
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=omni_minio
MINIO_SECRET_KEY=omni_minio_password
MINIO_BUCKET_KNOWLEDGE=omni-knowledge
MINIO_SECURE=false

# OCR
OCR_PROVIDER=mock